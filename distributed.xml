<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd" >
<suite name="DistributedSuite"
       parallel="false"
       verbose="2">

    <!-- =======================
         PHASE 1: Web Tests (Sequential)
         ======================= -->
    <test name="Web_Tests_Sequential" parallel="false">
        <classes>
       		<class name="com.scripts.resource.Web_5_PantaloonsHomepage2"/>
            <class name="com.scripts.resource.Web_4_BMWHomePage2"/>
        </classes>
    </test>


    <!-- =======================
         PHASE 2: Android Tests (Parallel)
         ======================= -->
    <test name="Android_Tests_Parallel"
          parallel="classes"
          thread-count="2">
        
        <classes>
            <class name="com.scripts.resource.Android_1_Mobile_Browser"/>
            <class name="com.scripts.resource.ANDROID_2_GeneralStore_Script"/>
        </classes>
    </test>

</suite>
